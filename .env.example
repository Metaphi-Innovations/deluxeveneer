# Application Configuration
VITE_APP_NAME=Deluxe Veneers
VITE_APP_ENV=development

# API Configuration
VITE_API_URL=http://localhost:5000/api

# Dev autofill: show "Autofill test data" on inward add and user-management add. Omit or false to hide (default).
# VITE_INWARD_AUTOFILL=true

# Bulk user import (CSV template + upload on user listing). Also set USER_BULK_IMPORT_ENABLED on the API.
# VITE_USER_BULK_IMPORT=true

# Optional local login. When set, the login page fills superadmin@deluxe-veneers.com
# with this password and signs in as soon as it opens. Leave empty to type login yourself.
# VITE_DEV_LOGIN_PASSWORD=
