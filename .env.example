# Application Configuration
VITE_APP_NAME=Deluxe Veneers
VITE_APP_ENV=development

# API Configuration
VITE_API_URL=http://localhost:5000/api

# Inward add form: show "Autofill test data" when true. Omit or false to hide (default).
